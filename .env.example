# Bu dosyayı .env olarak kopyalayıp doldurun. .env asla repoya/paylaşıma eklenmemeli.

DATABASE_URL=sqlite:///./data/haberbotu.db
# Üretimde Postgres önerilir:
# DATABASE_URL=postgresql+psycopg2://newsletter:sifre@db:5432/newsletter

SECRET_KEY=your-super-secret-key-change-this
APP_TIMEZONE=Europe/Istanbul
APP_BRAND_NAME=NewsLetter
APP_BASE_URL=http://localhost:8000
TRIAL_DAYS=7

# --- Shopier (ödeme) ---
SHOPIER_STARTER_30_URL=https://www.shopier.com/...
SHOPIER_STARTER_90_URL=https://www.shopier.com/...
SHOPIER_STARTER_180_URL=https://www.shopier.com/...
SHOPIER_STARTER_365_URL=https://www.shopier.com/...
SHOPIER_PRO_30_URL=https://www.shopier.com/...
SHOPIER_PRO_90_URL=https://www.shopier.com/...
SHOPIER_PRO_180_URL=https://www.shopier.com/...
SHOPIER_PRO_365_URL=https://www.shopier.com/...

SHOPIER_PAT=
SHOPIER_WEBSITE_INDEX=1
SHOPIER_MODULE_VERSION=1.0.4

SUBSCRIPTION_DAYS=30
RENEWAL_REMINDER_DAYS_BEFORE=3

# --- Platform sahibi ---
PLATFORM_OWNER_EMAIL=admin@example.com

# --- Gönderim için SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD="your-app-password"
MAIL_FROM=your-email@gmail.com
MAIL_FROM_NAME=NewsLetter

# --- Bülten içeriği ---
NEWSLETTER_LOOKBACK_HOURS=24
ARTICLES_PER_CATEGORY=6
